services:
  web:
    build: .
    env_file:
      - .env
    environment:
      CHOKIDAR_USEPOLLING: "true"
    ports:
      - "3000:3000"
    command: npm run dev
    volumes:
      - .:/app
      - /app/node_modules/
    depends_on:
      - db

  db:
    image: postgres:latest
    environment:
      POSTGRES_USER: admin
      POSTGRES_PASSWORD: password123
      POSTGRES_DB: iot_dashboard
    ports:
      - "5434:5432"
    volumes:
      - db-data:/var/lib/postgresql

volumes:
  db-data:
    name: postgres_dev_data